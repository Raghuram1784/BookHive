# ==========================================================
# Online Book Store Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==========================================================

# Port the Spring Boot application runs on
PORT=8081

# Database connection URL
DB_URL=jdbc:mysql://localhost:3306/onlinebookstore?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# Database credentials
DB_USERNAME=root
DB_PASSWORD=root
